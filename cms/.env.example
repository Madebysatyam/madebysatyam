# Local default: SQLite file (no cloud services needed)
DATABASE_URL=file:./payload.db

# Production / Vercel: use Postgres (Neon or Vercel Postgres).
# Either POSTGRES_URL (Vercel/Neon default) or a postgres DATABASE_URL works.
# POSTGRES_URL=postgres://USER:PASSWORD@HOST/DB?sslmode=require

PAYLOAD_SECRET=YOUR_SECRET_HERE_USE_A_LONG_RANDOM_STRING

# Public URL of this CMS app
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000

# Portfolio site origin(s) for CORS — comma-separated if you have preview + production
FRONTEND_URL=http://localhost:5173

# Vercel Blob — set automatically when you connect Blob in the Vercel dashboard.
# When present, uploads go to Blob instead of local cms/media/
# BLOB_READ_WRITE_TOKEN=

# Optional: set to "false" after first successful prod deploy if you manage migrations yourself
# PAYLOAD_DATABASE_PUSH=true
